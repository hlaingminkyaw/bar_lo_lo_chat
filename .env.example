# ==============================================================================
# BarLoLo Chat Environment Configuration
# ==============================================================================
# Instructions:
# 1. Local Dev: Copy this file to `.env` (cp .env.example .env) and set your keys.
# 2. Vercel: Add the same variables under Project Settings → Environment Variables.
# 3. Docker Compose: Reads `.env` automatically when running `docker compose up -d`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI / LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Choose provider: openrouter (default) | gemini | openai | groq | ollama | custom
AI_PROVIDER=openrouter

# Enable $0 cost free models on OpenRouter (:free models)
USE_FREE_MODELS=true

# Optional model override (leave empty to use smart provider defaults):
# - OpenRouter Free: nvidia/nemotron-3.5-lightning:free | nvidia/nemotron-3-ultra-550b-a55b:free
# - Gemini:          gemini-2.5-flash | gemini-2.0-flash
# - OpenAI:          gpt-4o-mini | gpt-4o
# - Groq:            llama-3.3-70b-versatile
# - Ollama:          llama3.2 | mistral
LLM_MODEL=

# Vision model for image OCR extraction (leave empty to use provider default)
# - OpenRouter Free: nvidia/nemotron-3.5-super-vl:free
# - Gemini:          gemini-2.5-flash
VISION_MODEL=

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CREDENTIALS & ENDPOINTS
# (Fill the key matching your chosen AI_PROVIDER)
# ------------------------------------------------------------------------------
# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Ollama (Local, no key required)
OLLAMA_HOST=http://localhost:11434

# Custom OpenAI-compatible endpoint
# AI_BASE_URL=https://your-custom-llm.com/v1
# AI_API_KEY=

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Choose vector DB: pinecone (cloud starter) | qdrant (local container or cloud)
VECTOR_DB=pinecone

# --- Pinecone Settings (if VECTOR_DB=pinecone) ---
# https://app.pinecone.io → API Keys
PINECONE_API_KEY=
PINECONE_INDEX=rag-chat-bot
PINECONE_NAMESPACE=default

# --- Qdrant Settings (if VECTOR_DB=qdrant) ---
# Local Docker: http://localhost:6333 (app uses http://qdrant:6333 inside docker network)
# Qdrant Cloud: https://xxxxxx-xxxx-xxxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=barlolo-chat
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. EMBEDDING PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: pinecone (free hosted on Starter) | openrouter | openai
# Recommended for Qdrant + OpenRouter free setup:
#   EMBEDDING_PROVIDER=openrouter
#   EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL=llama-text-embed-v2

# ------------------------------------------------------------------------------
# 5. RAG RETRIEVAL & CHUNKING TUNING
# ------------------------------------------------------------------------------
# Target character length per chunk (Burmese Unicode text split)
CHUNK_SIZE=1000
# Character overlap across adjacent chunks
CHUNK_OVERLAP=150
# Number of nearest neighbor chunks retrieved for context
TOP_K=6
# Max generated output tokens (Burmese requires headroom: 4096 recommended)
MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# 6. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
ALLOWED_ORIGIN=*
MAX_UPLOAD_MB=4
SITE_URL=
APP_NAME=BarLoLo Chat
