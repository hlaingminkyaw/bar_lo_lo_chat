# Copy to .env for local dev:  cp .env.example .env
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# ── Required ────────────────────────────────────────────────────────────────
# https://app.pinecone.io → API Keys
PINECONE_API_KEY=
# Name of the index; `npm run setup-index` creates it if it doesn't exist
PINECONE_INDEX=rag-chat-bot
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Protects POST /api/ingest. Generate one with:  openssl rand -hex 32
INGEST_SECRET=

# ── Optional (defaults shown) ───────────────────────────────────────────────
# Chat model. Avoid "openrouter/free": it can route to safety classifiers.
# Free alternative (often rate-limited): google/gemma-4-31b-it:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embeddings: "pinecone" (free hosted inference on the Starter plan) or "openrouter"
EMBEDDING_PROVIDER=pinecone
# pinecone:   llama-text-embed-v2 (1024 dims) | multilingual-e5-large (1024 dims)
# openrouter: openai/text-embedding-3-small (1536 dims) | qwen/qwen3-embedding-4b | ...
# Changing the model changes the dimension: rerun setup-index with a new index name.
EMBEDDING_MODEL=llama-text-embed-v2

PINECONE_NAMESPACE=default
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6

# CORS origin allowed to call the API, e.g. https://your-frontend.com
ALLOWED_ORIGIN=*

# Optional OpenRouter attribution headers
SITE_URL=
APP_NAME=BarLoLo Chat

# Max tokens per answer. Burmese needs far more tokens than English.
MAX_TOKENS=4096

# Vision model used to OCR uploaded images (must accept image input).
VISION_MODEL=google/gemini-2.5-flash
# Max size per uploaded file. Vercel caps request bodies at 4.5 MB.
MAX_UPLOAD_MB=4
